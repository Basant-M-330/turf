# Local Postgres container credentials (docker-compose.yml's `postgres` service reads these
# directly; DATABASE_URL below must match them for host-side access, e.g. `pnpm dev` outside Docker).
POSTGRES_USER="turf"
POSTGRES_PASSWORD="turf"
POSTGRES_DB="turf"

DATABASE_URL="postgresql://turf:turf@localhost:5432/turf"
REDIS_URL="redis://localhost:6379"

NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Per-deployment branding — fill these in for each client (src/lib/config.ts)
BRAND_NAME="Turf Booking"
BRAND_LEGAL_NAME="Turf Booking"
SUPPORT_EMAIL="support@example.com"
# "true" to enable the multi-court admin UI and court picker; omit/"false" for single-court.
MULTI_COURT="false"

# Transactional email (password reset, booking confirmations). Leave blank in local dev —
# emails are logged to the console instead of sent when this is unset.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Court photo uploads. Leave blank in local dev — uploads fall back to local disk
# (public/uploads) when this is unset. Required on Vercel (its filesystem is read-only),
# where Vercel creates this automatically once a Blob store is attached to the project.
BLOB_READ_WRITE_TOKEN=""
