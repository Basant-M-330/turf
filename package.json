{
  "name": "turf",
  "private": true,
  "version": "0.0.0",
  "description": "Multi-Location Turf Booking and Management Platform (monorepo root)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
